# Flutter build artifacts (regenerable via `flutter build`)
application/build/
application/.dart_tool/
application/.idea/
application/android/.gradle/

# Outils tiers telecharges (pas notre travail, regenerable)
kicad/tools/*.jar

# Logs et rapports de debug KiCad/Freerouting (non essentiels)
kicad/multical/*.log
kicad/multical/erc_*.json
kicad/multical/drc_*.json
kicad/multical/~*.lck
kicad/multical/.history/

# Fichiers temporaires divers
*.pyc
__pycache__/

# Sauvegardes locales du rapport (faites avant chaque edition, pas du travail en soi)
rapport/*.bak*

# Sauvegardes locales diverses (kicad, presentation) - pas du travail en soi
*.bak

# Fichiers de verrouillage/temporaires drawio (meme logique que LibreOffice)
rapport/.$*.drawio.bkp
rapport/.$*.drawio.dtmp

# PlatformIO build/deps (regenerable via `pio run`)
firmware/.pio/
firmware_pcb_capteurs_reels/.pio/
.~lock.*#

